# Copier ce fichier vers .env.local et renseigner les valeurs.
# Ne jamais committer .env.local (déjà dans .gitignore).

# URL publique du blog (canonical, sitemap, partages)
BLOG_URL=https://blogia.fr

# Bot Telegram pour confirmation de publication (npm run publish)
# Créer un bot via @BotFather, récupérer le token et votre chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optionnel — génération / enrichissement d’articles via Gemini (scripts éditoriaux)
GEMINI_API_KEY=
